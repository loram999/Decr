# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: Master administrator Google email allowed to access hidden admin controls
ADMIN_EMAIL=""

# VAULT_SECRET_KEY: Optional 32+ char secret for AES-256-GCM at-rest credential encryption
VAULT_SECRET_KEY=""

# TELEGRAM_BOT_TOKEN: Optional Telegram Bot token for server-side audit alerts
TELEGRAM_BOT_TOKEN=""

# ADMIN_ID: Optional Telegram chat ID for server-side audit alerts
ADMIN_ID=""
